# GrabIt — environment template. Copy to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# --- Supabase (TRD §3.2) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (TRD §3.3) — not implemented yet, deferred to a later phase ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Cashfree Payment Gateway (order payments + Super Admin payout wallet funding) ---
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=SANDBOX
CASHFREE_API_VERSION=2023-08-01

# --- Cashfree Payouts (separate product/credentials — vendor payouts, NOT the PG above) ---
CASHFREE_PAYOUTS_CLIENT_ID=
CASHFREE_PAYOUTS_CLIENT_SECRET=
CASHFREE_PAYOUTS_ENVIRONMENT=SANDBOX

# --- WhatsApp Business API (TRD §3.3) — not implemented yet ---
WHATSAPP_BUSINESS_API_TOKEN=
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=

# --- Google Maps Platform ---
GOOGLE_MAPS_SERVER_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- SMS fallback provider — not implemented yet ---
SMS_PROVIDER_API_KEY=

# --- Telegram Bot Integration (Daily Vendor Settlements) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUPERADMIN_CHAT_ID=
CRON_SECRET=

# --- Resend (Transactional Email) — server-side only, never expose to client ---
# RESEND_FROM_EMAIL must use a domain verified in Resend before production sending.
RESEND_API_KEY=
RESEND_FROM_EMAIL=GrabIt <noreply@grabit.ventures>
RESEND_REPLY_TO=support.grabit@gmail.com

# --- Absolute base URL for server-generated links (password reset, etc.) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
